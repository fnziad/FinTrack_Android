# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Source files (enforce LF)
*.kt text eol=lf
*.swift text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.sh text eol=lf
gradlew text eol=lf

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.keystore binary
*.jks binary
*.framework binary
